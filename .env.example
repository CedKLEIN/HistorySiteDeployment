# Image versions (tags published by the CI of HistorySiteFrontend / HistorySiteBackend)
UI_IMAGE=cedkl/history-site-ui:latest
API_IMAGE=cedkl/history-site-api:latest

# Port exposed for the UI (http://localhost:<UI_PORT>)
UI_PORT=8080

# URL the UI nginx uses to reach the API ("api" = compose service name on the internal network)
BACKEND_URL=http://api:8080

# Public URL of the site, used to build the password reset links sent by email
FRONTEND_URL=https://roisempereurs.fr

# Gmail app password used by the API to send contact emails
# (create one at https://myaccount.google.com/apppasswords after enabling 2-step verification)
SMTP_PASSWORD=

# Admin email(s) that receive the contact messages
ADMIN_EMAIL=souverainsdefrance1214@gmail.com

# Secret key used to sign JWT tokens (long random string, keep it secret).
# Generate one with:  openssl rand -base64 48
# The backend refuses to start in Production without it.
JWT_SECRET=

# Optional overrides for the JWT issuer/audience
JWT_ISSUER=HistorySiteBackend
JWT_AUDIENCE=HistorySiteFrontend

# Password of the single seeded administrator account (the email comes from ADMIN_EMAIL)
ADMIN_PASSWORD=
