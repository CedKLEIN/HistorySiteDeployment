# Image versions (tags published by the CI of HistorySiteFrontend / HistorySiteBackend)
HISTORY_UI_IMAGE=cedkl/history-site-ui:latest
HISTORY_API_IMAGE=cedkl/history-site-api:latest

# Port exposed for the UI (http://localhost:<HISTORY_UI_PORT>)
HISTORY_UI_PORT=8080

# URL the UI nginx uses to reach the API ("api" = compose service name on the internal network)
BACKEND_URL=http://api:8080

# Sentry DSN for client-side error monitoring (optional, empty = Sentry disabled).
# Injected into index.html at container start by nginx. Get one from https://sentry.io
# (project type Vite/React, then Settings -> Projects -> Client Keys (DSN)).
VITE_SENTRY_DSN=

# Public URL of the site, used to build the password reset links sent by email
FRONTEND_URL=https://roisempereurs.fr

# Gmail app password used by the API to send contact emails
# (create one at https://myaccount.google.com/apppasswords after enabling 2-step verification)
HISTORY_SMTP_PASSWORD=

# Admin email(s) that receive the contact messages
HISTORY_ADMIN_EMAIL=souverainsdefrance1214@gmail.com

# Secret key used to sign JWT tokens (long random string, keep it secret).
# Generate one with:  openssl rand -base64 48
# The backend refuses to start in Production without it.
HISTORY_JWT_SECRET=

# Optional overrides for the JWT issuer/audience
HISTORY_JWT_ISSUER=HistorySiteBackend
HISTORY_JWT_AUDIENCE=HistorySiteFrontend

# Password of the single seeded administrator account (the email comes from HISTORY_ADMIN_EMAIL)
HISTORY_ADMIN_PASSWORD=

# Souverain du jour : chaque matin à 9 h (heure de Paris), une fiche publiée sur Bluesky, et deux
# ajoutées au flux https://roisempereurs.fr/api/social/pinterest.rss que Pinterest publie seul ;
# le vendredi, une époque (dynastie ou régime) en plus. Tout est coupé tant que rien n'est à true.
# HISTORY_BLUESKY_HANDLE : le compte du site (ex. roisempereurs.bsky.social).
# HISTORY_BLUESKY_APP_PASSWORD : un mot de passe d'application (Réglages > Confidentialité et
#   sécurité > Mots de passe d'application), jamais le mot de passe du compte.
# HISTORY_PINTEREST_ENABLED : sert le flux et l'alimente. À brancher ensuite dans Pinterest (compte
#   professionnel, site revendiqué, Paramètres > Importer en masse > Connecter un flux RSS).
# Préfixe HISTORY_ obligatoire : SportSiteDeployment (Denivio) a ses propres BLUESKY_* sur le même VPS.
HISTORY_BLUESKY_ENABLED=false
HISTORY_BLUESKY_HANDLE=
HISTORY_BLUESKY_APP_PASSWORD=
HISTORY_PINTEREST_ENABLED=false
